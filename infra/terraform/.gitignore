# Provider binaries and workspace metadata. Regenerated by `terraform init`.
.terraform/
.terraform.tfstate.lock.info

# Real variable values. terraform.tfvars.example is the committed template;
# anything ending .tfvars holds account ids, ARNs and hostnames and does not
# belong in git.
*.tfvars
!*.tfvars.example
env/

# State never lives here — the backend is S3. If one of these appears, an
# `init` was run without -backend-config and it must not be committed.
*.tfstate
*.tfstate.*
crash.log

# Plan files can contain variable values, including anything sensitive that
# was passed on the command line.
*.tfplan
