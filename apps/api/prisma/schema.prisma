// MCOS — Milestone 1 schema.
//
// Two invariants the shape of this file is designed to enforce:
//   1. Every table carries tenant_id. The Prisma client extension in src/db.ts
//      injects it into every query, so a cross-tenant read is not expressible.
//   2. Provenance is structural. A candidate_claim requires an evidence_source
//      and at least one claim_segment. A claim without evidence linkage is
//      invalid and cannot be written.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  // Every Better Auth Organization has exactly one Tenant, created with it.
  //
  // Two names for one concept is usually a smell, and this is the exception:
  // `Organization` is Better Auth's — its shape is fixed by the library and its
  // rows are written by the auth layer. `Tenant` is the domain's, and it is what
  // the row-level tenancy extension keys off, on every table, in every query.
  // Collapsing them would mean either the auth library owning the tenancy
  // anchor or a migration across every table in the schema. The 1:1 is enforced
  // (unique FK, created in the same transaction) so they cannot drift.
  organizationId String?       @unique @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  calendarConnections  CalendarConnection[]
  calendarEvents       CalendarEvent[]
  agendaItems          AgendaItem[]
  actionItems          ActionItem[]
  meetingNotes         MeetingNote[]
  meetingShares        MeetingShare[]
  meetingCollaborators MeetingCollaborator[]

  meetings        Meeting[]
  evidenceSources EvidenceSource[]
  transcripts     Transcript[]
  segments        TranscriptSegment[]
  artifacts       Artifact[]
  extractionRuns  ExtractionRun[]
  claims          CandidateClaim[]
  reviewDecisions ReviewDecision[]
  briefVersions   BriefVersion[]
  briefClaims     BriefClaim[]
  transitions     StateTransition[]
  webhookEvents   WebhookEvent[]

  @@map("tenants")
}

// ---------------------------------------------------------------------------
// Meetings + state machine
// ---------------------------------------------------------------------------

enum MeetingStatus {
  draft
  bot_scheduled
  bot_joined
  recording
  call_ended
  media_processing
  transcript_ready
  extracting
  in_review
  merged
  failed

  @@map("meeting_status")
}

model Meeting {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  title      String?
  meetingUrl String    @map("meeting_url")
  joinAt     DateTime? @map("join_at")

  status        MeetingStatus @default(draft)
  failureReason String?       @map("failure_reason")
  failedStage   String?       @map("failed_stage")

  // Recall handles. Unique so a webhook can find its meeting without a scan.
  recallBotId        String? @unique @map("recall_bot_id")
  recallRecordingId  String? @unique @map("recall_recording_id")
  recallTranscriptId String? @unique @map("recall_transcript_id")

  platform   String?
  startedAt  DateTime? @map("started_at")
  endedAt    DateTime? @map("ended_at")
  durationMs Int?      @map("duration_ms")

  // Who created it, and who is allowed to see it.
  createdByUserId String?           @map("created_by_user_id")
  createdBy       User?             @relation("MeetingCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  visibility      MeetingVisibility @default(workspace)
  organizerEmail  String?           @map("organizer_email")

  // Deletion path: purge sets deletedAt and redacts evidence on merged claims.
  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transitions     StateTransition[]
  evidenceSources EvidenceSource[]
  transcript      Transcript?
  artifacts       Artifact[]
  claims          CandidateClaim[]
  extractionRuns  ExtractionRun[]
  briefClaims     BriefClaim[]

  calendarEvent CalendarEvent?
  note          MeetingNote?
  agendaItems   AgendaItem[]
  actionItems   ActionItem[]
  shares        MeetingShare[]
  collaborators MeetingCollaborator[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("meetings")
}

model StateTransition {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  meetingId  String         @map("meeting_id")
  fromStatus MeetingStatus? @map("from_status")
  toStatus   MeetingStatus  @map("to_status")
  reason     String?
  occurredAt DateTime       @default(now()) @map("occurred_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, occurredAt])
  @@map("state_transitions")
}

// ---------------------------------------------------------------------------
// Evidence — pluggable. Only meeting_transcript is implemented in Milestone 1.
// ---------------------------------------------------------------------------

enum EvidenceKind {
  meeting_transcript
  performance_metric
  document

  @@map("evidence_kind")
}

model EvidenceSource {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  kind       EvidenceKind
  meetingId  String?      @map("meeting_id")
  externalId String?      @map("external_id")
  capturedAt DateTime     @map("captured_at")
  metadata   Json         @default("{}")
  createdAt  DateTime     @default(now()) @map("created_at")

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meeting    Meeting?         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  transcript Transcript?
  claims     CandidateClaim[]

  @@unique([tenantId, kind, externalId])
  @@index([tenantId, kind])
  @@map("evidence_sources")
}

model Transcript {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  meetingId        String @unique @map("meeting_id")
  evidenceSourceId String @unique @map("evidence_source_id")

  provider           String
  languageCode       String? @map("language_code")
  recallTranscriptId String? @map("recall_transcript_id")
  segmentCount       Int     @map("segment_count")
  wordCount          Int     @map("word_count")
  durationMs         Int     @map("duration_ms")

  createdAt DateTime @default(now()) @map("created_at")

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meeting        Meeting             @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  evidenceSource EvidenceSource      @relation(fields: [evidenceSourceId], references: [id], onDelete: Cascade)
  segments       TranscriptSegment[]

  @@map("transcripts")
}

model TranscriptSegment {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  transcriptId String @map("transcript_id")
  idx          Int
  speaker      String
  speakerId    Int?   @map("speaker_id")
  startMs      Int    @map("start_ms")
  endMs        Int    @map("end_ms")
  text         String

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transcript  Transcript     @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  claimLinks  ClaimSegment[]
  actionItems ActionItem[]

  @@unique([transcriptId, idx])
  @@index([transcriptId, startMs])
  @@map("transcript_segments")
}

// ---------------------------------------------------------------------------
// Artifacts — immutable once written. R2 is the system of record for media.
// ---------------------------------------------------------------------------

enum ArtifactKind {
  recording_audio
  recording_video
  transcript_json

  @@map("artifact_kind")
}

model Artifact {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  meetingId   String       @map("meeting_id")
  kind        ArtifactKind
  r2Key       String       @unique @map("r2_key")
  contentType String       @map("content_type")
  bytes       BigInt
  checksum    String?
  sourceUrl   String?      @map("source_url")

  createdAt DateTime  @default(now()) @map("created_at")
  purgedAt  DateTime? @map("purged_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, kind])
  @@map("artifacts")
}

// ---------------------------------------------------------------------------
// Extraction — proposes, never writes memory.
// ---------------------------------------------------------------------------

enum ExtractionStatus {
  running
  succeeded
  failed

  @@map("extraction_status")
}

model ExtractionRun {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  meetingId     String           @map("meeting_id")
  model         String
  promptVersion String           @map("prompt_version")
  status        ExtractionStatus @default(running)

  chunkCount     Int @default(0) @map("chunk_count")
  proposedCount  Int @default(0) @map("proposed_count")
  droppedCount   Int @default(0) @map("dropped_count")
  duplicateCount Int @default(0) @map("duplicate_count")
  persistedCount Int @default(0) @map("persisted_count")

  inputTokens  Int @default(0) @map("input_tokens")
  outputTokens Int @default(0) @map("output_tokens")

  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  error      String?

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meeting Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  claims  CandidateClaim[]

  @@index([meetingId, startedAt])
  @@map("extraction_runs")
}

enum ClaimType {
  positioning_statement
  icp_fact
  pain_point
  objection
  messaging_decision
  competitor_mention
  proof_point

  @@map("claim_type")
}

enum ClaimStatus {
  proposed
  approved
  rejected
  edited

  @@map("claim_status")
}

model CandidateClaim {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  meetingId        String @map("meeting_id")
  evidenceSourceId String @map("evidence_source_id")
  extractionRunId  String @map("extraction_run_id")

  type       ClaimType
  text       String
  editedText String?     @map("edited_text")
  confidence Float
  status     ClaimStatus @default(proposed)

  // Provenance, denormalised for the review card so it renders in one query.
  verbatimQuote String @map("verbatim_quote")
  speaker       String
  timestampMs   Int    @map("timestamp_ms")

  dedupeKey String @map("dedupe_key")

  // Which model proposed this claim. The run's model is the run-level record;
  // this pins it to the row so provenance survives even a re-run with a
  // different model. Nullable: claims extracted before the column existed.
  extractedByModel String? @map("extracted_by_model")

  createdAt DateTime  @default(now()) @map("created_at")
  decidedAt DateTime? @map("decided_at")
  mergedAt  DateTime? @map("merged_at")

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meeting        Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  evidenceSource EvidenceSource   @relation(fields: [evidenceSourceId], references: [id], onDelete: Cascade)
  extractionRun  ExtractionRun    @relation(fields: [extractionRunId], references: [id], onDelete: Cascade)
  segments       ClaimSegment[]
  decisions      ReviewDecision[]
  briefClaims    BriefClaim[]

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status, type])
  @@index([meetingId, status])
  @@map("candidate_claims")
}

// The provenance FK. A claim with no rows here never made it past validation.
model ClaimSegment {
  claimId   String @map("claim_id")
  segmentId String @map("segment_id")

  claim   CandidateClaim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  segment TranscriptSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@id([claimId, segmentId])
  @@index([segmentId])
  @@map("claim_segments")
}

// ---------------------------------------------------------------------------
// The review gate. Append-only. Non-negotiable.
// ---------------------------------------------------------------------------

enum ReviewAction {
  approve
  reject
  edit_approve

  @@map("review_action")
}

model ReviewDecision {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  claimId      String       @map("claim_id")
  action       ReviewAction
  reviewer     String
  previousText String?      @map("previous_text")
  editedText   String?      @map("edited_text")
  note         String?
  createdAt    DateTime     @default(now()) @map("created_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  claim  CandidateClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([claimId, createdAt])
  @@map("review_decisions")
}

// ---------------------------------------------------------------------------
// Living Positioning Brief — append-only. Version N = version N-1 + delta.
// ---------------------------------------------------------------------------

model BriefVersion {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  version   Int
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by")
  note      String?

  addedCount   Int @default(0) @map("added_count")
  removedCount Int @default(0) @map("removed_count")
  editedCount  Int @default(0) @map("edited_count")
  totalCount   Int @default(0) @map("total_count")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  claims BriefClaim[]

  @@unique([tenantId, version])
  @@map("brief_versions")
}

// Text is frozen at merge time — a later edit to a candidate claim cannot
// retroactively rewrite what an earlier version of the brief said.
model BriefClaim {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  briefVersionId String @map("brief_version_id")
  claimId        String @map("claim_id")
  meetingId      String @map("meeting_id")

  type          ClaimType
  text          String
  verbatimQuote String    @map("verbatim_quote")
  speaker       String
  timestampMs   Int       @map("timestamp_ms")
  confidence    Float

  // Set when the source meeting is deleted. The claim survives; the evidence
  // is redacted.
  evidenceRedacted Boolean @default(false) @map("evidence_redacted")

  // Which version first introduced this claim — lets the diff distinguish
  // "carried forward" from "added in this version" without a self-join.
  introducedInVersion Int @map("introduced_in_version")

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  briefVersion BriefVersion   @relation(fields: [briefVersionId], references: [id], onDelete: Cascade)
  claim        CandidateClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  meeting      Meeting        @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([briefVersionId, claimId])
  @@index([tenantId, type])
  @@map("brief_claims")
}

// ---------------------------------------------------------------------------
// Webhook log — raw payload retained for replay and debugging.
// ---------------------------------------------------------------------------

model WebhookEvent {
  id       String  @id @default(uuid())
  tenantId String? @map("tenant_id")

  eventType String @map("event_type")
  // (event type, bot/recording id, updated_at) — Recall may deliver a webhook
  // more than once and out of order.
  dedupeKey String @unique @map("dedupe_key")

  botId        String? @map("bot_id")
  recordingId  String? @map("recording_id")
  transcriptId String? @map("transcript_id")

  payload     Json
  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")
  error       String?

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([eventType, receivedAt])
  @@index([botId])
  @@map("webhook_events")
}

// ===========================================================================
// Authentication and workspace membership.
//
// Generated by `npx @better-auth/cli generate` — these models' shapes belong to
// Better Auth, not to us. Regenerate rather than hand-edit; a field renamed here
// breaks the adapter at runtime, not at compile time.
// ===========================================================================

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  role          String?
  banned        Boolean?     @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  // Domain back-relations.
  createdMeetings      Meeting[]             @relation("MeetingCreator")
  calendarConnections  CalendarConnection[]
  ownedAgendaItems     AgendaItem[]          @relation("AgendaOwner")
  assignedActionItems  ActionItem[]          @relation("ActionAssignee")
  editedNotes          MeetingNote[]         @relation("NoteEditor")
  meetingCollaborators MeetingCollaborator[]
  preference           UserPreference?

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
  impersonatedBy       String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id String @id

  /// Better Auth 1.7 scopes account identity by issuer: the same accountId can
  /// legitimately exist under two issuers. Required, and half of the unique key
  /// — without it every sign-up dies inside the adapter with
  /// `Unknown argument 'issuer'`.
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]

  tenant Tenant?

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ---------------------------------------------------------------------------
// Calendar — evidence ingestion, automated.
// ---------------------------------------------------------------------------

enum CalendarProvider {
  google
  microsoft

  @@map("calendar_provider")
}

enum CalendarConnectionStatus {
  active
  // The refresh token was rejected. The user must re-consent; syncing stops
  // rather than retrying a grant that will never succeed again.
  reauth_required
  disabled

  @@map("calendar_connection_status")
}

model CalendarConnection {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  userId   String @map("user_id")

  provider          CalendarProvider
  providerAccountId String           @map("provider_account_id")
  email             String
  calendarId        String           @default("primary") @map("calendar_id")

  // Google returns a nextSyncToken, Microsoft a deltaLink. Both mean "resume
  // from here"; both are invalidated by the provider without warning, which is
  // why a sync that 410s must fall back to a full resync rather than give up.
  syncToken     String?   @map("sync_token")
  lastSyncedAt  DateTime? @map("last_synced_at")
  lastSyncError String?   @map("last_sync_error")

  // Push notification channel, so we are not polling every calendar every minute.
  watchChannelId  String?   @map("watch_channel_id")
  watchResourceId String?   @map("watch_resource_id")
  watchExpiresAt  DateTime? @map("watch_expires_at")

  status CalendarConnectionStatus @default(active)

  // Recording is opt-in per connection and never retroactive.
  autoRecord      Boolean @default(false) @map("auto_record")
  // Narrowing rules: {"externalOnly":true,"minAttendees":2,"titleExcludes":["1:1"]}
  autoRecordRules Json    @default("{}") @map("auto_record_rules")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  events CalendarEvent[]

  @@unique([userId, provider, providerAccountId, calendarId])
  @@index([tenantId, status])
  @@index([watchExpiresAt])
  @@map("calendar_connections")
}

model CalendarEvent {
  id           String @id @default(uuid())
  tenantId     String @map("tenant_id")
  connectionId String @map("connection_id")

  externalId String  @map("external_id")
  iCalUid    String? @map("ical_uid")

  title          String?
  description    String?
  startsAt       DateTime @map("starts_at")
  endsAt         DateTime @map("ends_at")
  timezone       String?
  organizerEmail String?  @map("organizer_email")
  attendees      Json     @default("[]")
  isRecurring    Boolean  @default(false) @map("is_recurring")
  cancelled      Boolean  @default(false)

  // Parsed out of the event body / conferencing data.
  meetingUrl String? @map("meeting_url")
  platform   String?

  /// What the rules decided, recomputed on every sync.
  autoRecord Boolean @default(false) @map("auto_record")

  /// What a human decided for this one event, and the reason the two are
  /// separate columns: the sync recomputes `autoRecord` from the connection's
  /// rules on every pass, so storing an override in the same field meant the
  /// next sync silently undid it. Null means "no opinion, use the rules".
  autoRecordOverride Boolean? @map("auto_record_override")

  /// The sync already refuses all-day events; storing the flag lets the read
  /// path reproduce that decision instead of inferring it from a missing link.
  allDay Boolean @default(false) @map("all_day")

  botDispatched Boolean @default(false) @map("bot_dispatched")

  meetingId String?  @unique @map("meeting_id")
  meeting   Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  raw       Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalId])
  @@index([tenantId, startsAt])
  @@index([startsAt, botDispatched])
  @@map("calendar_events")
}

// ---------------------------------------------------------------------------
// Agendas, notes and action items.
// ---------------------------------------------------------------------------

/// Freeform collaborative notes. The Yjs document is the source of truth; the
/// snapshot here is a durable checkpoint, not the live state.
model MeetingNote {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  meetingId String @unique @map("meeting_id")

  // Yjs state vector update. Opaque to everything except the CRDT.
  state           Bytes
  // Plain-text projection, kept only so full-text search has something to index.
  plainText       String   @default("") @map("plain_text")
  revision        Int      @default(0)
  updatedAt       DateTime @updatedAt @map("updated_at")
  updatedByUserId String?  @map("updated_by_user_id")

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  updatedBy User?   @relation("NoteEditor", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("meeting_notes")
}

/// Structured, orderable agenda. Separate from notes on purpose: an agenda item
/// has an owner, a duration and a done state, none of which survive being a
/// paragraph in a CRDT.
model AgendaItem {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  meetingId String @map("meeting_id")

  position     Int
  title        String
  description  String?
  durationMins Int?    @map("duration_mins")
  completed    Boolean @default(false)

  ownerUserId     String? @map("owner_user_id")
  createdByUserId String? @map("created_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  owner   User?   @relation("AgendaOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([meetingId, position])
  @@map("agenda_items")
}

/// How a meeting gets recorded by default, before per-event overrides.
enum AutoRecordMode {
  none
  /// Every calendar event with a joinable link.
  all
  /// Only events with at least one attendee outside the workspace.
  external
  /// Only events this user organises.
  owned

  @@map("auto_record_mode")
}

/// Personal defaults. Distinct from CalendarConnection.autoRecordRules, which
/// is per-calendar: this is the preference a new connection inherits, and what
/// the settings menu edits. A per-connection rule always wins.
model UserPreference {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  autoRecordMode  AutoRecordMode @default(none) @map("auto_record_mode")
  timezone        String?
  /// Reserved for a desktop-capture option later; only "bot" exists today.
  recordingMethod String         @default("bot") @map("recording_method")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

/// Whether a human wrote this item or a model proposed it.
enum ActionItemOrigin {
  manual
  ai_suggested

  @@map("action_item_origin")
}

enum ActionItemStatus {
  open
  in_progress
  done
  cancelled

  @@map("action_item_status")
}

model ActionItem {
  id        String  @id @default(uuid())
  tenantId  String  @map("tenant_id")
  meetingId String? @map("meeting_id")

  title       String
  description String?
  status      ActionItemStatus @default(open)
  dueAt       DateTime?        @map("due_at")

  /// A suggested item is a proposal, not a commitment. It stays out of the
  /// working lists until someone accepts it — the same shape as the claim
  /// review gate, for the same reason: a model may not add work to a person's
  /// plate on its own.
  origin      ActionItemOrigin @default(manual)
  dismissedAt DateTime?        @map("dismissed_at")
  acceptedAt  DateTime?        @map("accepted_at")

  /// Free-text bucket, e.g. "Top priority". Null means the inbox.
  groupName String? @map("group_name")

  assigneeUserId  String? @map("assignee_user_id")
  createdByUserId String? @map("created_by_user_id")

  // An action item lifted from the transcript keeps its citation, for the same
  // reason claims do: someone will eventually dispute that it was ever agreed.
  sourceSegmentId String? @map("source_segment_id")

  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meeting  Meeting?           @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  assignee User?              @relation("ActionAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  source   TranscriptSegment? @relation(fields: [sourceSegmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, dueAt])
  @@index([assigneeUserId, status])
  @@index([tenantId, origin, dismissedAt])
  @@map("action_items")
}

// ---------------------------------------------------------------------------
// Sharing and access.
// ---------------------------------------------------------------------------

enum MeetingVisibility {
  /// Only the creator and explicitly named collaborators.
  private
  /// Every member of the workspace.
  workspace

  @@map("meeting_visibility")
}

enum CollaboratorRole {
  viewer
  editor

  @@map("collaborator_role")
}

model MeetingCollaborator {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  meetingId String @map("meeting_id")
  userId    String @map("user_id")

  role      CollaboratorRole @default(viewer)
  createdAt DateTime         @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([userId])
  @@map("meeting_collaborators")
}

/// A share link. Revocable, expirable, and never a way around tenancy — the
/// token resolves to exactly one meeting in exactly one tenant.
model MeetingShare {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  meetingId String @map("meeting_id")

  token            String    @unique
  expiresAt        DateTime? @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  /// Share links never expose the recording or the raw transcript, only the
  /// notes and approved claims. Opt in explicitly.
  includeRecording Boolean   @default(false) @map("include_recording")
  viewCount        Int       @default(0) @map("view_count")

  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@map("meeting_shares")
}
