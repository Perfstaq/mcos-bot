// MCOS — Milestone 1 schema.
//
// Two invariants the shape of this file is designed to enforce:
//   1. Every table carries tenant_id. The Prisma client extension in src/db.ts
//      injects it into every query, so a cross-tenant read is not expressible.
//   2. Provenance is structural. A candidate_claim requires an evidence_source
//      and at least one claim_segment. A claim without evidence linkage is
//      invalid and cannot be written.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  // Every Better Auth Organization has exactly one Tenant, created with it.
  //
  // Two names for one concept is usually a smell, and this is the exception:
  // `Organization` is Better Auth's — its shape is fixed by the library and its
  // rows are written by the auth layer. `Tenant` is the domain's, and it is what
  // the row-level tenancy extension keys off, on every table, in every query.
  // Collapsing them would mean either the auth library owning the tenancy
  // anchor or a migration across every table in the schema. The 1:1 is enforced
  // (unique FK, created in the same transaction) so they cannot drift.
  organizationId String?       @unique @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  calendarConnections  CalendarConnection[]
  calendarEvents       CalendarEvent[]
  agendaItems          AgendaItem[]
  actionItems          ActionItem[]
  meetingNotes         MeetingNote[]
  meetingShares        MeetingShare[]
  meetingCollaborators MeetingCollaborator[]

  meetings        Meeting[]
  evidenceSources EvidenceSource[]
  transcripts     Transcript[]
  segments        TranscriptSegment[]
  artifacts       Artifact[]
  extractionRuns  ExtractionRun[]
  claims          CandidateClaim[]
  reviewDecisions ReviewDecision[]
  briefVersions   BriefVersion[]
  briefClaims     BriefClaim[]
  transitions     StateTransition[]
  webhookEvents   WebhookEvent[]

  // Content Studio (additive — ARCHITECTURE.md §3). MotionTemplate is a
  // global catalog (no tenant_id) and has no back-relation here.
  mediaAssets   MediaAsset[]
  mediaAnalyses MediaAnalysis[]
  renderPlans   RenderPlan[]
  renders       Render[]

  // Content Studio — brief integration (additive — ARCHITECTURE.md §6, ADR-6).
  contentBriefs         ContentBrief[]
  contentBriefDecisions ContentBriefDecision[]

  @@map("tenants")
}

// ---------------------------------------------------------------------------
// Meetings + state machine
// ---------------------------------------------------------------------------

enum MeetingStatus {
  draft
  bot_scheduled
  bot_joined
  recording
  call_ended
  media_processing
  transcript_ready
  extracting
  in_review
  merged
  failed

  @@map("meeting_status")
}

model Meeting {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  title      String?
  meetingUrl String    @map("meeting_url")
  joinAt     DateTime? @map("join_at")

  // A cheap one-line digest generated once the transcript lands, so the
  // meetings list and review queue have something better than the raw URL to
  // show. Best-effort: a failure here never touches `status`, and it never
  // overwrites a title a human already gave the meeting — see jobs/digest.ts.
  digest              String?   @db.Text
  digestModel         String?   @map("digest_model")
  // Which prompt/schema version of jobs/digest.ts produced this digest — the
  // same reasoning as extraction_runs.prompt_version: a digest nobody can
  // trace to the harness that wrote it is a digest nobody can debug.
  digestPromptVersion String?   @map("digest_prompt_version")
  digestGeneratedAt   DateTime? @map("digest_generated_at")

  status        MeetingStatus @default(draft)
  failureReason String?       @map("failure_reason")
  failedStage   String?       @map("failed_stage")

  // Recall handles. Unique so a webhook can find its meeting without a scan.
  recallBotId        String? @unique @map("recall_bot_id")
  recallRecordingId  String? @unique @map("recall_recording_id")
  recallTranscriptId String? @unique @map("recall_transcript_id")

  platform   String?
  startedAt  DateTime? @map("started_at")
  endedAt    DateTime? @map("ended_at")
  durationMs Int?      @map("duration_ms")

  // Who created it, and who is allowed to see it.
  createdByUserId String?           @map("created_by_user_id")
  createdBy       User?             @relation("MeetingCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  visibility      MeetingVisibility @default(workspace)
  organizerEmail  String?           @map("organizer_email")

  // Deletion path: purge sets deletedAt and redacts evidence on merged claims.
  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transitions     StateTransition[]
  evidenceSources EvidenceSource[]
  transcript      Transcript?
  artifacts       Artifact[]
  claims          CandidateClaim[]
  extractionRuns  ExtractionRun[]
  briefClaims     BriefClaim[]
  mergedInto      BriefVersion[]    @relation("BriefVersionSource")

  calendarEvent CalendarEvent?
  note          MeetingNote?
  agendaItems   AgendaItem[]
  actionItems   ActionItem[]
  shares        MeetingShare[]
  collaborators MeetingCollaborator[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("meetings")
}

model StateTransition {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  meetingId  String         @map("meeting_id")
  fromStatus MeetingStatus? @map("from_status")
  toStatus   MeetingStatus  @map("to_status")
  reason     String?
  occurredAt DateTime       @default(now()) @map("occurred_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, occurredAt])
  @@map("state_transitions")
}

// ---------------------------------------------------------------------------
// Evidence — pluggable. Only meeting_transcript is implemented in Milestone 1.
// ---------------------------------------------------------------------------

enum EvidenceKind {
  meeting_transcript
  performance_metric
  document

  @@map("evidence_kind")
}

model EvidenceSource {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  kind       EvidenceKind
  meetingId  String?      @map("meeting_id")
  externalId String?      @map("external_id")
  capturedAt DateTime     @map("captured_at")
  metadata   Json         @default("{}")
  createdAt  DateTime     @default(now()) @map("created_at")

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meeting    Meeting?         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  transcript Transcript?
  claims     CandidateClaim[]

  @@unique([tenantId, kind, externalId])
  @@index([tenantId, kind])
  @@map("evidence_sources")
}

model Transcript {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  meetingId        String @unique @map("meeting_id")
  evidenceSourceId String @unique @map("evidence_source_id")

  provider           String
  languageCode       String? @map("language_code")
  recallTranscriptId String? @map("recall_transcript_id")
  segmentCount       Int     @map("segment_count")
  wordCount          Int     @map("word_count")
  durationMs         Int     @map("duration_ms")

  createdAt DateTime @default(now()) @map("created_at")

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meeting        Meeting             @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  evidenceSource EvidenceSource      @relation(fields: [evidenceSourceId], references: [id], onDelete: Cascade)
  segments       TranscriptSegment[]

  @@map("transcripts")
}

model TranscriptSegment {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  transcriptId String @map("transcript_id")
  idx          Int
  speaker      String
  speakerId    Int?   @map("speaker_id")
  startMs      Int    @map("start_ms")
  endMs        Int    @map("end_ms")
  text         String

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transcript  Transcript     @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  claimLinks  ClaimSegment[]
  actionItems ActionItem[]

  @@unique([transcriptId, idx])
  @@index([transcriptId, startMs])
  @@map("transcript_segments")
}

// ---------------------------------------------------------------------------
// Artifacts — immutable once written. R2 is the system of record for media.
// ---------------------------------------------------------------------------

enum ArtifactKind {
  recording_audio
  recording_video
  transcript_json

  @@map("artifact_kind")
}

model Artifact {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  meetingId   String       @map("meeting_id")
  kind        ArtifactKind
  r2Key       String       @unique @map("r2_key")
  contentType String       @map("content_type")
  bytes       BigInt
  checksum    String?
  sourceUrl   String?      @map("source_url")

  createdAt DateTime  @default(now()) @map("created_at")
  purgedAt  DateTime? @map("purged_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, kind])
  @@map("artifacts")
}

// ---------------------------------------------------------------------------
// Extraction — proposes, never writes memory.
// ---------------------------------------------------------------------------

enum ExtractionStatus {
  running
  succeeded
  failed

  @@map("extraction_status")
}

model ExtractionRun {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  meetingId     String           @map("meeting_id")
  model         String
  promptVersion String           @map("prompt_version")
  status        ExtractionStatus @default(running)

  chunkCount     Int @default(0) @map("chunk_count")
  proposedCount  Int @default(0) @map("proposed_count")
  droppedCount   Int @default(0) @map("dropped_count")
  duplicateCount Int @default(0) @map("duplicate_count")
  persistedCount Int @default(0) @map("persisted_count")

  inputTokens  Int @default(0) @map("input_tokens")
  outputTokens Int @default(0) @map("output_tokens")

  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  error      String?

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meeting Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  claims  CandidateClaim[]

  @@index([meetingId, startedAt])
  @@map("extraction_runs")
}

enum ClaimType {
  positioning_statement
  icp_fact
  pain_point
  objection
  messaging_decision
  competitor_mention
  proof_point

  @@map("claim_type")
}

enum ClaimStatus {
  proposed
  approved
  rejected
  /// Legacy. Edit-approve used to rewrite the claim in place and mark it
  /// `edited`; it now writes a new row and supersedes the old one. Rows written
  /// before that change keep this status and still merge into the brief.
  edited
  /// Replaced by an edit-approved successor. The row is kept — it is the text a
  /// human was shown when they decided — and is never a merge candidate again.
  superseded

  @@map("claim_status")
}

model CandidateClaim {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  meetingId        String @map("meeting_id")
  evidenceSourceId String @map("evidence_source_id")
  extractionRunId  String @map("extraction_run_id")

  type       ClaimType
  text       String
  editedText String?     @map("edited_text")
  confidence Float
  status     ClaimStatus @default(proposed)

  // Provenance, denormalised for the review card so it renders in one query.
  verbatimQuote String @map("verbatim_quote")
  speaker       String
  timestampMs   Int    @map("timestamp_ms")

  dedupeKey String @map("dedupe_key")

  // Which model proposed this claim. The run's model is the run-level record;
  // this pins it to the row so provenance survives even a re-run with a
  // different model. Nullable: claims extracted before the column existed.
  extractedByModel String? @map("extracted_by_model")

  // The claim this one was edited from — always the ORIGINAL of the lineage,
  // never the immediate predecessor, so a claim rewritten five times still has
  // one stable identity. The brief keys its rows off that identity, which is
  // what lets version N+1 report an edit rather than an add plus a removal.
  editedFromId String?          @map("edited_from_id")
  editedFrom   CandidateClaim?  @relation("ClaimEdits", fields: [editedFromId], references: [id], onDelete: Cascade)
  edits        CandidateClaim[] @relation("ClaimEdits")

  createdAt DateTime  @default(now()) @map("created_at")
  decidedAt DateTime? @map("decided_at")
  mergedAt  DateTime? @map("merged_at")

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meeting        Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  evidenceSource EvidenceSource   @relation(fields: [evidenceSourceId], references: [id], onDelete: Cascade)
  extractionRun  ExtractionRun    @relation(fields: [extractionRunId], references: [id], onDelete: Cascade)
  segments       ClaimSegment[]
  decisions      ReviewDecision[]
  briefClaims    BriefClaim[]

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status, type])
  @@index([meetingId, status])
  @@index([tenantId, editedFromId])
  @@map("candidate_claims")
}

// The provenance FK. A claim with no rows here never made it past validation.
model ClaimSegment {
  claimId   String @map("claim_id")
  segmentId String @map("segment_id")

  claim   CandidateClaim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  segment TranscriptSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@id([claimId, segmentId])
  @@index([segmentId])
  @@map("claim_segments")
}

// ---------------------------------------------------------------------------
// The review gate. Append-only. Non-negotiable.
// ---------------------------------------------------------------------------

enum ReviewAction {
  approve
  reject
  edit_approve
  /// A compensating decision. Undo never deletes the decision it reverses —
  /// the audit log only ever grows, so "who kept this, and did they change
  /// their mind" stays answerable.
  undo

  @@map("review_action")
}

model ReviewDecision {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  claimId      String       @map("claim_id")
  action       ReviewAction
  reviewer     String
  previousText String?      @map("previous_text")
  editedText   String?      @map("edited_text")
  note         String?
  createdAt    DateTime     @default(now()) @map("created_at")

  // The row this decision produced (edit-approve: the successor claim) or
  // compensated (undo: the successor it withdrew). Deliberately not a foreign
  // key: the audit log must outlive the rows it describes, and a cascade is
  // exactly how an append-only log quietly loses entries.
  resultClaimId String? @map("result_claim_id")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  claim  CandidateClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([claimId, createdAt])
  @@index([resultClaimId])
  @@map("review_decisions")
}

// ---------------------------------------------------------------------------
// Living Positioning Brief — append-only. Version N = version N-1 + delta.
// ---------------------------------------------------------------------------

model BriefVersion {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  version   Int
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by")
  note      String?

  // The call the reviewer had just finished when they pressed merge.
  //
  // Provenance for the merge ACTION, not for its contents: the claims carry
  // their own meetingId, and one version can legitimately gather approvals
  // from several meetings. Nullable and SetNull on delete — a purged meeting
  // must never take a published version with it.
  sourceMeetingId String? @map("source_meeting_id")

  addedCount   Int @default(0) @map("added_count")
  removedCount Int @default(0) @map("removed_count")
  editedCount  Int @default(0) @map("edited_count")
  totalCount   Int @default(0) @map("total_count")

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceMeeting Meeting? @relation("BriefVersionSource", fields: [sourceMeetingId], references: [id], onDelete: SetNull)

  claims BriefClaim[]

  @@unique([tenantId, version])
  @@index([tenantId, sourceMeetingId])
  @@map("brief_versions")
}

// Text is frozen at merge time — a later edit to a candidate claim cannot
// retroactively rewrite what an earlier version of the brief said.
model BriefClaim {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  briefVersionId String @map("brief_version_id")
  claimId        String @map("claim_id")
  meetingId      String @map("meeting_id")

  type          ClaimType
  text          String
  verbatimQuote String    @map("verbatim_quote")
  speaker       String
  timestampMs   Int       @map("timestamp_ms")
  confidence    Float

  // Set when the source meeting is deleted. The claim survives; the evidence
  // is redacted.
  evidenceRedacted Boolean @default(false) @map("evidence_redacted")

  // Which version first introduced this claim — lets the diff distinguish
  // "carried forward" from "added in this version" without a self-join.
  introducedInVersion Int @map("introduced_in_version")

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  briefVersion BriefVersion   @relation(fields: [briefVersionId], references: [id], onDelete: Cascade)
  claim        CandidateClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  meeting      Meeting        @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([briefVersionId, claimId])
  @@index([tenantId, type])
  @@map("brief_claims")
}

// ---------------------------------------------------------------------------
// Webhook log — raw payload retained for replay and debugging.
// ---------------------------------------------------------------------------

model WebhookEvent {
  id       String  @id @default(uuid())
  tenantId String? @map("tenant_id")

  eventType String @map("event_type")
  // (event type, bot/recording id, updated_at) — Recall may deliver a webhook
  // more than once and out of order.
  dedupeKey String @unique @map("dedupe_key")

  botId        String? @map("bot_id")
  recordingId  String? @map("recording_id")
  transcriptId String? @map("transcript_id")

  payload     Json
  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")
  error       String?

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([eventType, receivedAt])
  @@index([botId])
  @@map("webhook_events")
}

// ===========================================================================
// Authentication and workspace membership.
//
// Generated by `npx @better-auth/cli generate` — these models' shapes belong to
// Better Auth, not to us. Regenerate rather than hand-edit; a field renamed here
// breaks the adapter at runtime, not at compile time.
// ===========================================================================

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  role          String?
  banned        Boolean?     @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  // Domain back-relations.
  createdMeetings      Meeting[]             @relation("MeetingCreator")
  calendarConnections  CalendarConnection[]
  ownedAgendaItems     AgendaItem[]          @relation("AgendaOwner")
  assignedActionItems  ActionItem[]          @relation("ActionAssignee")
  editedNotes          MeetingNote[]         @relation("NoteEditor")
  meetingCollaborators MeetingCollaborator[]
  preference           UserPreference?

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
  impersonatedBy       String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id String @id

  /// Better Auth 1.7 scopes account identity by issuer: the same accountId can
  /// legitimately exist under two issuers. Required, and half of the unique key
  /// — without it every sign-up dies inside the adapter with
  /// `Unknown argument 'issuer'`.
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]

  tenant Tenant?

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ---------------------------------------------------------------------------
// Calendar — evidence ingestion, automated.
// ---------------------------------------------------------------------------

enum CalendarProvider {
  google
  microsoft

  @@map("calendar_provider")
}

enum CalendarConnectionStatus {
  active
  // The refresh token was rejected. The user must re-consent; syncing stops
  // rather than retrying a grant that will never succeed again.
  reauth_required
  disabled

  @@map("calendar_connection_status")
}

model CalendarConnection {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  userId   String @map("user_id")

  provider          CalendarProvider
  providerAccountId String           @map("provider_account_id")
  email             String
  calendarId        String           @default("primary") @map("calendar_id")

  // Google returns a nextSyncToken, Microsoft a deltaLink. Both mean "resume
  // from here"; both are invalidated by the provider without warning, which is
  // why a sync that 410s must fall back to a full resync rather than give up.
  syncToken     String?   @map("sync_token")
  lastSyncedAt  DateTime? @map("last_synced_at")
  lastSyncError String?   @map("last_sync_error")

  // Push notification channel, so we are not polling every calendar every minute.
  watchChannelId  String?   @map("watch_channel_id")
  watchResourceId String?   @map("watch_resource_id")
  watchExpiresAt  DateTime? @map("watch_expires_at")

  status CalendarConnectionStatus @default(active)

  // Recording is opt-in per connection and never retroactive.
  autoRecord      Boolean @default(false) @map("auto_record")
  // Narrowing rules: {"externalOnly":true,"minAttendees":2,"titleExcludes":["1:1"]}
  autoRecordRules Json    @default("{}") @map("auto_record_rules")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  events CalendarEvent[]

  @@unique([userId, provider, providerAccountId, calendarId])
  @@index([tenantId, status])
  @@index([watchExpiresAt])
  @@map("calendar_connections")
}

model CalendarEvent {
  id           String @id @default(uuid())
  tenantId     String @map("tenant_id")
  connectionId String @map("connection_id")

  externalId String  @map("external_id")
  iCalUid    String? @map("ical_uid")

  title          String?
  description    String?
  startsAt       DateTime @map("starts_at")
  endsAt         DateTime @map("ends_at")
  timezone       String?
  organizerEmail String?  @map("organizer_email")
  attendees      Json     @default("[]")
  isRecurring    Boolean  @default(false) @map("is_recurring")
  cancelled      Boolean  @default(false)

  // Parsed out of the event body / conferencing data.
  meetingUrl String? @map("meeting_url")
  platform   String?

  /// What the rules decided, recomputed on every sync.
  autoRecord Boolean @default(false) @map("auto_record")

  /// What a human decided for this one event, and the reason the two are
  /// separate columns: the sync recomputes `autoRecord` from the connection's
  /// rules on every pass, so storing an override in the same field meant the
  /// next sync silently undid it. Null means "no opinion, use the rules".
  autoRecordOverride Boolean? @map("auto_record_override")

  /// The sync already refuses all-day events; storing the flag lets the read
  /// path reproduce that decision instead of inferring it from a missing link.
  allDay Boolean @default(false) @map("all_day")

  botDispatched Boolean @default(false) @map("bot_dispatched")

  meetingId String?  @unique @map("meeting_id")
  meeting   Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  raw       Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalId])
  @@index([tenantId, startsAt])
  @@index([startsAt, botDispatched])
  @@map("calendar_events")
}

// ---------------------------------------------------------------------------
// Agendas, notes and action items.
// ---------------------------------------------------------------------------

/// Freeform collaborative notes. The Yjs document is the source of truth; the
/// snapshot here is a durable checkpoint, not the live state.
model MeetingNote {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  meetingId String @unique @map("meeting_id")

  // Yjs state vector update. Opaque to everything except the CRDT.
  state           Bytes
  // Plain-text projection, kept only so full-text search has something to index.
  plainText       String   @default("") @map("plain_text")
  revision        Int      @default(0)
  updatedAt       DateTime @updatedAt @map("updated_at")
  updatedByUserId String?  @map("updated_by_user_id")

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  updatedBy User?   @relation("NoteEditor", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("meeting_notes")
}

/// Structured, orderable agenda. Separate from notes on purpose: an agenda item
/// has an owner, a duration and a done state, none of which survive being a
/// paragraph in a CRDT.
model AgendaItem {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  meetingId String @map("meeting_id")

  position     Int
  title        String
  description  String?
  durationMins Int?    @map("duration_mins")
  completed    Boolean @default(false)

  ownerUserId     String? @map("owner_user_id")
  createdByUserId String? @map("created_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  owner   User?   @relation("AgendaOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([meetingId, position])
  @@map("agenda_items")
}

/// How a meeting gets recorded by default, before per-event overrides.
enum AutoRecordMode {
  none
  /// Every calendar event with a joinable link.
  all
  /// Only events with at least one attendee outside the workspace.
  external
  /// Only events this user organises.
  owned

  @@map("auto_record_mode")
}

/// Personal defaults. Distinct from CalendarConnection.autoRecordRules, which
/// is per-calendar: this is the preference a new connection inherits, and what
/// the settings menu edits. A per-connection rule always wins.
model UserPreference {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  autoRecordMode  AutoRecordMode @default(none) @map("auto_record_mode")
  timezone        String?
  /// Reserved for a desktop-capture option later; only "bot" exists today.
  recordingMethod String         @default("bot") @map("recording_method")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

/// Whether a human wrote this item or a model proposed it.
enum ActionItemOrigin {
  manual
  ai_suggested

  @@map("action_item_origin")
}

enum ActionItemStatus {
  open
  in_progress
  done
  cancelled

  @@map("action_item_status")
}

model ActionItem {
  id        String  @id @default(uuid())
  tenantId  String  @map("tenant_id")
  meetingId String? @map("meeting_id")

  title       String
  description String?
  status      ActionItemStatus @default(open)
  dueAt       DateTime?        @map("due_at")

  /// A suggested item is a proposal, not a commitment. It stays out of the
  /// working lists until someone accepts it — the same shape as the claim
  /// review gate, for the same reason: a model may not add work to a person's
  /// plate on its own.
  origin      ActionItemOrigin @default(manual)
  dismissedAt DateTime?        @map("dismissed_at")
  acceptedAt  DateTime?        @map("accepted_at")

  /// Free-text bucket, e.g. "Top priority". Null means the inbox.
  groupName String? @map("group_name")

  assigneeUserId  String? @map("assignee_user_id")
  createdByUserId String? @map("created_by_user_id")

  // An action item lifted from the transcript keeps its citation, for the same
  // reason claims do: someone will eventually dispute that it was ever agreed.
  sourceSegmentId String? @map("source_segment_id")

  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meeting  Meeting?           @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  assignee User?              @relation("ActionAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  source   TranscriptSegment? @relation(fields: [sourceSegmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, dueAt])
  @@index([assigneeUserId, status])
  @@index([tenantId, origin, dismissedAt])
  @@map("action_items")
}

// ---------------------------------------------------------------------------
// Sharing and access.
// ---------------------------------------------------------------------------

enum MeetingVisibility {
  /// Only the creator and explicitly named collaborators.
  private
  /// Every member of the workspace.
  workspace

  @@map("meeting_visibility")
}

enum CollaboratorRole {
  viewer
  editor

  @@map("collaborator_role")
}

model MeetingCollaborator {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  meetingId String @map("meeting_id")
  userId    String @map("user_id")

  role      CollaboratorRole @default(viewer)
  createdAt DateTime         @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([userId])
  @@map("meeting_collaborators")
}

/// A share link. Revocable, expirable, and never a way around tenancy — the
/// token resolves to exactly one meeting in exactly one tenant.
model MeetingShare {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  meetingId String @map("meeting_id")

  token            String    @unique
  expiresAt        DateTime? @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  /// Share links never expose the recording or the raw transcript, only the
  /// notes and approved claims. Opt in explicitly.
  includeRecording Boolean   @default(false) @map("include_recording")
  viewCount        Int       @default(0) @map("view_count")

  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@map("meeting_shares")
}

// ---------------------------------------------------------------------------
// Content Studio — media, analysis, templates, plans, renders.
// (Additive migration — ARCHITECTURE.md §3. Invariant 6: no destructive
// changes, no renames of existing columns/models above this line.)
// ---------------------------------------------------------------------------

enum MediaAssetKind {
  footage
  reference
  render
  music

  @@map("media_asset_kind")
}

model MediaAsset {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  kind         MediaAssetKind
  r2Key        String         @unique @map("r2_key")
  contentType  String         @map("content_type")
  bytes        BigInt
  checksum     String?
  originalName String?        @map("original_name")

  durationMs Int?   @map("duration_ms")
  width      Int?
  height     Int?
  fps        Float?

  uploadedByUserId String? @map("uploaded_by_user_id")

  // Reference reels are purged after fingerprinting (04 §5) — same posture as
  // artifacts.purged_at: the row survives, the bytes do not.
  purgedAt  DateTime? @map("purged_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  analysis MediaAnalysis?
  plans    RenderPlan[]

  @@index([tenantId, kind, createdAt])
  @@map("media_assets")
}

enum MediaAnalysisStatus {
  running
  succeeded
  failed

  @@map("media_analysis_status")
}

model MediaAnalysis {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  assetId String @unique @map("asset_id")

  status MediaAnalysisStatus @default(running)
  error  String?

  // Signal payloads (03 §1); each null until its stage lands.
  words  Json? // word-level timings (faster-whisper), ms
  beats  Json? // { method, tempo_bpm, beat_times_ms[], grid_quality } — THE canonical grid (§4)
  scenes Json? // PySceneDetect shot list (reference assets only)
  motion Json? // per-window motion energy
  faces  Json? // per-span face boxes + luminance map

  // The EditFingerprint (04_STYLE_TRANSFER §3), for `reference` assets only.
  //
  // Its own column rather than a reuse of `scenes`/`motion`: those are
  // reserved for per-signal MediaAnalysis payloads about FOOTAGE, while this
  // is one composite object describing a reference reel's structure, with
  // per-field confidences that only make sense together.
  //
  // This is also what makes 04 §5's retention posture implementable — "store
  // only the fingerprint long-term; the reference video itself is deleted
  // after analysis". The bytes go (MediaAsset.purgedAt) and this row is what
  // survives, which is a deliberate PDPL/GDPR position: we keep a structural
  // description we derived, never a copy of someone else's video.
  fingerprint        Json?   @map("fingerprint")
  // Pins the extractor build that produced `fingerprint`, exactly as
  // `analyzerVersion` pins the sidecar. A fingerprint measured by a different
  // extractor is a different measurement, and the acceptance thresholds are
  // calibrated per-extractor (ADR-8 §4.1(3)).
  fingerprintVersion String? @map("fingerprint_version")

  tempoBpm   Float?  @map("tempo_bpm")
  beatMethod String? @map("beat_method") // 'beat_track' | 'onset_env' | 'constant_grid'

  // Pins the sidecar (and its librosa version) that produced this row —
  // same reasoning as extraction_runs.prompt_version.
  analyzerVersion String @map("analyzer_version")

  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset  MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("media_analyses")
}

enum TemplateFraming {
  letterbox
  fill

  @@map("template_framing")
}

// Global catalog — NO tenant_id; must be listed in db.ts UNSCOPED. Rows are
// seeded by fixture (explicitly marked; templates are not memory, so the gate
// invariant does not apply to them).
model MotionTemplate {
  id        String @id @default(uuid())
  name      String
  archetype String

  framing TemplateFraming
  slots   Json // rhythm-slot spec: establish/accelerate/hold pattern
  fonts   Json // 02 §7 typography tokens
  grade   Json // 02 §6 grade parameters

  version Int     @default(1)
  active  Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  plans RenderPlan[]

  @@unique([name, version])
  @@map("motion_templates")
}

// Immutable once written (APPEND_ONLY_MODELS): the reproducible artifact.
// plan embeds EVERYTHING the render consumes — cut list, caption chunks with
// word timings, emphasis flags, motion curves, grade, music asset id, beat
// grid, seed — so a re-render never recomputes analysis or re-runs an LLM.
model RenderPlan {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  // Was a plain column until Agent B's ContentBrief model landed; the relation
  // below is added in this additive migration (see ARCHITECTURE.md §6).
  //
  // CAVEAT for whoever runs this migration against a database that already
  // has render_plans rows: the new FK constraint (render_plans.content_brief_id
  // -> content_briefs.id) would fail to apply against any existing row whose
  // content_brief_id does not resolve to a real ContentBrief — which is every
  // row created before this migration, since ContentBrief did not exist yet.
  // Safe on every database this migration has actually been applied to
  // (mcos_test_b, mcos_test_p) because no job processor creates RenderPlan
  // rows yet (`plan.build` has no consumer on this branch — see
  // routes/content.ts's own doc comment), so render_plans is empty
  // everywhere. Not safe to assume for a future database that already has
  // real renders in it; a from-scratch reproduction of a populated
  // environment against this migration would need a backfill or a data
  // migration first.
  contentBriefId String @map("content_brief_id")
  templateId     String @map("template_id")
  footageAssetId String @map("footage_asset_id")

  plan        Json
  seed        Int
  planVersion String @map("plan_version") // schema version of the plan payload
  createdBy   String @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contentBrief ContentBrief   @relation(fields: [contentBriefId], references: [id])
  template     MotionTemplate @relation(fields: [templateId], references: [id])
  footage      MediaAsset     @relation(fields: [footageAssetId], references: [id])
  renders      Render[]

  @@index([tenantId, contentBriefId])
  @@index([tenantId, createdAt])
  @@map("render_plans")
}

enum RenderStatus {
  queued
  rendering
  qc
  succeeded
  failed

  @@map("render_status")
}

model Render {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  planId String @map("plan_id")

  status         RenderStatus @default(queued)
  r2Key          String?      @unique @map("r2_key")
  durationMs     Int?         @map("duration_ms")
  bytes          BigInt?
  checksum       String? // G13: same plan+footage ⇒ same checksum
  qc             Json? // full gate-by-gate report from render.qc
  qcPassed       Boolean?     @map("qc_passed")
  lambdaRenderId String?      @map("lambda_render_id")

  // Mirrors meetings.failure_reason/failed_stage: failures are surfaced, never silent.
  error       String?
  failedStage String? @map("failed_stage") // analyze | plan | render | qc

  createdAt  DateTime  @default(now()) @map("created_at")
  finishedAt DateTime? @map("finished_at")

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   RenderPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([planId, createdAt])
  @@map("renders")
}

// ---------------------------------------------------------------------------
// Content Studio — ContentBrief: the handoff from the Living Positioning
// Brief into the Studio (05_BRIEF_INTEGRATION.md; ARCHITECTURE.md §6, ADR-6,
// §11.1 R3, §11.2 R4/R5, §11.3).
//
// "Reuse the review gate" (05 §3) does NOT mean the same review_decisions
// table — review_decisions.claim_id is a required FK to candidate_claims
// (schema.prisma:453), so a ContentBrief id cannot live there additively.
// What is actually reused is the DISCIPLINE: one decision table
// (ContentBriefDecision, append-only) + one gate module
// (domain/content-gate.ts, the only writer of ContentBrief.status) + a
// mirrored source-scan guard (tests/content-gate.test.ts). See ADR-6.
// ---------------------------------------------------------------------------

enum ContentBriefStatus {
  proposed
  approved
  rejected
  /// Replaced by an edit-approved successor. ARCHITECTURE.md §11.3: follow
  /// M1's lineage model (successor row + superseded), not 05 §1's "edited" —
  /// M1 deliberately migrated away from in-place editing.
  superseded

  @@map("content_brief_status")
}

enum ContentArchetype {
  objection_killer
  contrarian
  pain_ladder
  transformation
  myth_bust
  bts
  listicle
  client_story
  category_ed
  founder_pov

  @@map("content_archetype")
}

// How validated the chosen framework is. Denormalized onto the brief and
// frozen at generation time — ARCHITECTURE.md §11.2 R4, same rationale as
// claimSnapshots below (R3): the framework catalogue is a versioned TS const
// (see domain/studio/frameworks.ts), not a table, because it is editorial
// judgement that changes without a migration. A later catalogue revision must
// not retroactively change what an already-generated brief recorded.
enum EvidenceTier {
  A
  B
  C

  @@map("evidence_tier")
}

enum ContentChannel {
  reels
  shorts
  tiktok
  linkedin

  @@map("content_channel")
}

// 95/5 + 60/40 routing (05 §1).
enum ContentMixSlot {
  brand
  activation

  @@map("content_mix_slot")
}

enum ExpectedMetric {
  sends_per_reach
  saves
  watch_time
  profile_visits

  @@map("expected_metric")
}

model ContentBrief {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  // Which memory version produced this. Deliberately a plain id, not a Prisma
  // relation: BriefVersion's model block is off-limits to Studio agents
  // (ARCHITECTURE.md §6 — only Tenant may gain back-relation lines) and so
  // cannot gain the back-relation array Prisma would require. Same posture as
  // review_decisions.result_claim_id being deliberately not an FK.
  briefVersionId String @map("brief_version_id")

  // MANDATORY — provenance (05 §1 invariant, 00_MASTER §4.3 "citation or
  // refusal"). A brief with an empty array is invalid and must be dropped,
  // never persisted — enforced in the generation coercion layer, not here,
  // the same posture as coerceClaims in integrations/openai.ts (strict-mode
  // schemas cannot express "non-empty array").
  claimIds String[] @map("claim_ids")

  // Frozen snapshots of exactly those claims — {claim_id, type, text,
  // verbatim_quote, speaker, timestamp_ms}[] — taken from BriefClaim at
  // generation time (ARCHITECTURE.md §11.1 R3). Agent M's emphasis scorer
  // reads claim text from here and never reaches into claim tables (05 §1:
  // "neither side knows the other's internals"); freezing means a later edit
  // to the underlying claim cannot retroactively change what an
  // already-approved brief emphasised.
  claimSnapshots Json @map("claim_snapshots")

  // Validated at write time against the versioned TS catalogue
  // (domain/studio/frameworks.ts) — not a table (§11.2 R4).
  frameworkId           String       @map("framework_id")
  frameworkEvidenceTier EvidenceTier @map("framework_evidence_tier")

  archetype ContentArchetype

  hookText     String @map("hook_text")
  emphasisWord String @map("emphasis_word")
  // [{ role: hook|agitate|resolve|proof|cta, script, target_ms, fills_from }]
  beats        Json

  channel        ContentChannel
  contentMixSlot ContentMixSlot @map("content_mix_slot")
  expectedMetric ExpectedMetric @map("expected_metric")

  status ContentBriefStatus @default(proposed)

  // Lineage, mirroring candidate_claims.edited_from_id (review-gate.ts):
  // edit-approve writes a NEW row and marks this one superseded. Always the
  // ORIGINAL of the lineage, never the immediate predecessor.
  editedFromId String?        @map("edited_from_id")
  editedFrom   ContentBrief?  @relation("ContentBriefEdits", fields: [editedFromId], references: [id], onDelete: Cascade)
  edits        ContentBrief[] @relation("ContentBriefEdits")

  // 06_AGENTS_AND_MODELS.md §1: "Tag every generated ContentBrief with
  // generated_by_model. Never mix models within one brief."
  generatedByModel String  @map("generated_by_model")
  // Set when generation refused an archetype ("not in memory") instead of
  // inventing (05 §2-3) — surfaced for visibility, not itself a decision.
  generationNote   String? @map("generation_note")

  createdAt DateTime  @default(now()) @map("created_at")
  decidedAt DateTime? @map("decided_at")

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  decisions   ContentBriefDecision[]
  renderPlans RenderPlan[]

  @@index([tenantId, status, channel])
  @@index([tenantId, briefVersionId])
  @@index([tenantId, editedFromId])
  @@map("content_briefs")
}

enum ContentBriefAction {
  approve
  reject
  edit_approve
  undo

  @@map("content_brief_action")
}

// Append-only (ADR-6) — mirrors review_decisions exactly, one transaction
// with the ContentBrief.status flip, written only by domain/content-gate.ts.
model ContentBriefDecision {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  contentBriefId String             @map("content_brief_id")
  action         ContentBriefAction
  reviewer       String
  note           String?

  // The row this decision produced (edit-approve: the successor brief) or
  // withdrew (undo). Deliberately not a foreign key — same reasoning as
  // review_decisions.result_claim_id: the audit log must outlive the rows it
  // describes.
  resultBriefId String? @map("result_brief_id")

  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contentBrief ContentBrief @relation(fields: [contentBriefId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([contentBriefId, createdAt])
  @@index([resultBriefId])
  @@map("content_brief_decisions")
}
