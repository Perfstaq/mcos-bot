# ---------------------------------------------------------------------------
# MCOS — Milestone 1. Copy to .env and fill in. Secrets come from env only.
# ---------------------------------------------------------------------------

# --- Recall.ai -------------------------------------------------------------
# Region is fixed per workspace. API keys, webhook secrets, bots and recordings
# are region-scoped and NOT portable across regions.
# One of: us-east-1 | us-west-2 | eu-central-1 | ap-northeast-1
RECALL_REGION=us-east-1
RECALLAI_API_KEY=

# Workspace verification secret (Dashboard → Developers → API Keys & Secrets →
# Create Workspace Secret). Starts with "whsec_". Used to verify every webhook.
RECALL_WEBHOOK_SECRET=

# ONLY for Recall accounts created before 2025-12-15, which use a separate
# per-endpoint secret for dashboard webhooks. Leave EMPTY on newer accounts —
# setting it there breaks verification.
RECALL_SVIX_WEBHOOK_SECRET=

# Name the bot shows in the participant list.
RECALL_BOT_NAME=Perfstaq Notetaker
# Chat message posted when the bot joins. Empty disables the message.
RECALL_JOIN_MESSAGE=This meeting is being recorded and transcribed by Perfstaq.
# Audio + transcript only by default. true also captures mixed video (costs more).
RECALL_CAPTURE_VIDEO=false

# --- Public base URL -------------------------------------------------------
# Where Recall delivers webhooks. Must be publicly reachable and STABLE.
# Locally: a static ngrok URL. Never localhost or an IP — Recall 403s those.
APP_BASE_URL=https://your-static-subdomain.ngrok-free.app

# --- Deploy target ---------------------------------------------------------
# AWS Hyderabad. Opt-in region: enable it in Account -> AWS Regions before use,
# and check Fargate / RDS / ElastiCache instance-class availability per-AZ.
AWS_REGION=ap-south-2

# --- Cloudflare R2 ---------------------------------------------------------
# R2 has no Hyderabad location. Create the bucket with the closest hint:
#   npx wrangler r2 bucket create $R2_BUCKET --location apac
# The hint is set once at creation and is immutable. It is a placement
# preference, not a residency guarantee (R2 jurisdictions are eu/fedramp only).
CF_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mcos-artifacts
# Wrangler CLI only — bucket create/list. NOT read by the API (see env.ts):
# the S3 client authenticates with the R2 access key pair above, not this
# token. Set both so `npx wrangler r2 ...` runs without an interactive login.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- OpenAI (extraction) ---------------------------------------------------
OPENAI_API_KEY=
# gpt-5.6 ships as three tiers: sol (flagship), terra (balanced), luna (cheap).
# terra is the default for extraction; switch to gpt-5.6-sol if recall on messy
# transcripts is poor, or gpt-5.6-luna to cut cost on clean ones.
OPENAI_MODEL=gpt-5.6-terra
# minimal | low | medium | high. Extraction is mechanical once the schema is
# fixed, so low is enough; raise it if claim typing is sloppy.
OPENAI_REASONING_EFFORT=low

# --- Infrastructure --------------------------------------------------------
DATABASE_URL=postgresql://mcos:mcos@localhost:5433/mcos?schema=public
REDIS_URL=redis://localhost:6380

# --- Server ----------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:5173

# --- Authentication --------------------------------------------------------
# Better Auth. Must be at least 32 characters. Rotating it invalidates every
# session and pending verification token.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# Where the auth handler is reachable. Defaults to APP_BASE_URL when unset.
BETTER_AUTH_URL=
# The SPA origin users return to after an OAuth round-trip.
WEB_ORIGIN=http://localhost:5173

# Social sign-in AND calendar access ride on the same grant. Leave a pair empty
# to disable that provider entirely — a half-configured provider is not offered.
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID.
# Redirect URI: {APP_BASE_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Entra ID -> App registrations. Redirect: {APP_BASE_URL}/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# --- Ops -------------------------------------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
TRUST_PROXY=true

# --- Demo identity ---------------------------------------------------------
# Milestone 1 has no auth. Tenancy is enforced; identity is supplied by header
# (X-Tenant-Slug / X-Reviewer-Email) and falls back to these.
DEFAULT_TENANT_SLUG=freshworks-demo
DEFAULT_REVIEWER_EMAIL=demo@freshworks.example

# Accept X-Tenant-Slug / X-Reviewer-Email instead of a session. For the demo
# seed and local pipeline work only — refused in production regardless.
AUTH_DEV_HEADERS=false
