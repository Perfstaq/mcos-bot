# root .env is symlinked into apps/api for the Prisma CLI
apps/api/.env
*.tsbuildinfo

# Redundant with perfstaq-logos/perfstaq-logo/ — 683KB of duplicate bytes.
perfstaq-logos/*.zip

# Editor / OS noise
.idea/
.vscode/*
!.vscode/extensions.json

# e2e ring — generated per run by e2e/global-setup.ts, never committed
e2e/.state.json
e2e/.seed-result.json
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
# Already caught by the blanket *.log above — listed here too so it reads as
# one of this ring's own generated files, not an accident of a broader rule.
e2e/server.log

# Extraction eval output — regenerated by `npm run eval:extraction`; the
# committed snapshot is eval-results.golden.json
eval-results.json

# Content Studio media sidecar — Python venv, never committed (pins live in
# services/analyzer/requirements.txt; Dockerfile.media rebuilds it).
services/analyzer/.venv/
services/analyzer/__pycache__/
services/analyzer/stages/__pycache__/
*.pyc

# Studio render scratch: demo footage staged for local `remotion render`
# (ADR-7 dev/CI path). Real renders stream footage from R2 presigns.
packages/render/public/
packages/render/out/
